        <rect x="10" y="22" width="44" height="5" rx="1" fill="#fff" fill-opacity=".85" />
        <rect x="10" y="32" width="30" height="4" rx="1" fill="#fff" fill-opacity=".35" />
        <g fill="#fff" fill-opacity=".05" stroke="#fff" stroke-opacity=".14">
          <rect x="10" y="46" width="60" height="16" rx="3" />
          <rect x="10" y="68" width="60" height="16" rx="3" />
          <rect x="10" y="90" width="60" height="16" rx="3" />
        </g>
        <g fill="#fff" fill-opacity=".5">
          <rect x="16" y="52" width="22" height="4" rx="1" />
          <rect x="16" y="74" width="28" height="4" rx="1" />
          <rect x="16" y="96" width="18" height="4" rx="1" />
        </g>
        <g fill="none" stroke="#D7F24A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="m58 54 2.5 2.5 4.5-5M58 76l2.5 2.5 4.5-5M58 98l2.5 2.5 4.5-5" />
        </g>
        <rect x="10" y="118" width="60" height="16" rx="3" fill="#D7F24A" />
        <rect x="26" y="124" width="28" height="4" rx="1" fill="#113B2B" />
      </g>
    </svg>
  )
}
