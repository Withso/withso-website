---
type IconName = 'arrow-right' | 'arrow-external' | 'linkedin' | 'x' | 'github' | 'email' | 'menu' | 'close' | 'plus';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const arrowClass = name === 'arrow-right' ? 'arrow arrow--right' : name === 'arrow-external' ? 'arrow arrow--external' : undefined;
---

{
  name === 'arrow-right' && (
    <svg class:list={[arrowClass, className]} viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M3 8h9.5M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
    </svg>
  )
}
{
  name === 'arrow-external' && (
    <svg class:list={[arrowClass, className]} viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M5 11 11 5M6 4.5h5.5V10" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
    </svg>
  )
}
{
  name === 'linkedin' && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
    </svg>
  )
}
{
  name === 'x' && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" />
    </svg>
  )
}
{
  name === 'github' && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.02-2.04c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.62-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3Z" />
    </svg>
  )
}
{
  name === 'email' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="3" y="5.25" width="18" height="13.5" rx="1.5" stroke="currentColor" stroke-width="1.6" />
      <path d="m3.75 6.5 8.25 6.25 8.25-6.25" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 8.5h16M4 15.5h16" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === 'plus' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
